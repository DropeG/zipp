# The script first loads this folder's .env. It then fills missing values from
# PRODUCT_SYNC_SHARED_ENV_FILE when set, otherwise from ../stock-sync/.env.
# Do not commit real environment files.
PRODUCT_SYNC_SHARED_ENV_FILE=../stock-sync/.env
SHOPIFY_SHOP_URL=https://your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_replace_me
SHOPIFY_API_VERSION=2026-07

MELI_APP_ID=replace_me
MELI_CLIENT_SECRET=replace_me
MELI_EXPECTED_SELLER_ID=replace_me

# Defaults to ../stock-sync/data/meli_tokens.json.
PRODUCT_SYNC_MELI_TOKENS_FILE=../stock-sync/data/meli_tokens.json
# Prevent this publisher and the stock-sync worker from refreshing the shared
# Mercado Libre token or changing the same SKU at the same time.
PRODUCT_SYNC_STOCK_WORKER_LOCK=../stock-sync/data/stock_sync.db.worker-lock.db
PRODUCT_SYNC_STATE_FILE=data/state.json
MELI_LISTING_TYPE_ID=gold_special
MELI_SITE_ID=MLC
