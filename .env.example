# URL de tu tienda de Shopify (por ejemplo: zipp-cl.myshopify.com o zipp.cl)
SHOPIFY_SHOP_URL=5b3a60-3.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-04

# Credenciales de Mercado Libre (obtenidas en http://developers.mercadolibre.com)
MELI_APP_ID=tu_meli_app_id
MELI_CLIENT_SECRET=tu_meli_client_secret
MELI_REDIRECT_URI=https://localhost

# Clave de API de Google Gemini (obtenida en Google AI Studio)
GEMINI_API_KEY=tu_gemini_api_key
